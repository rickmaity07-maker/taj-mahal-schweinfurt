# Public URL of the site (used for sitemap, canonical links, social previews)
NEXT_PUBLIC_SITE_URL=https://www.tajmahal-schweinfurt.de

# Email delivery for orders, reservations, messages and rewards sign-ups (https://resend.com)
# Without these, submissions are printed to the server console in development
# and rejected with 503 in production.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=tajmahal2022@gmail.com
NOTIFY_EMAIL_FROM="Taj Mahal Website <orders@your-verified-domain.de>"
